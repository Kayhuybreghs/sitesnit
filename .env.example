PAGESPEED_API_KEY=
# Optional: Google Search Console verification value, never a Google API key.
GOOGLE_SITE_VERIFICATION=
# Public indexing is automatic only on production www.sitesnit.nl.
# Localhost and Vercel preview domains always remain noindex.
# Public GA4 measurement ID. No analytics is loaded without consent.
GA4_MEASUREMENT_ID=
# Enable only after Enhanced Measurement, Signals and user-provided data are disabled.
GA4_PRIVACY_CONFIGURED=false
# Neon PostgreSQL, provisioned through the Vercel Marketplace. Server-only.
DATABASE_URL=
# Set true ONLY in a local .env.local; omit on Vercel.
SITESNIT_LOCAL_SQLITE=false
# Independent random server secrets, at least 32 random bytes each.
RATE_LIMIT_SECRET=
CRON_SECRET=
# Optional paid customer service. Disabled until explicitly provisioned; never NEXT_PUBLIC.
HUB_ENABLED=false
HUB_AUTH_URL=https://www.sitesnit.nl
HUB_AUTH_SECRET=
HUB_EMAIL_ENABLED=false
HUB_EMAIL_FROM=
RESEND_API_KEY=
# Server-only JSON entries with credentialRef keys and explicit allowedSites.
# See docs/setup-hub-integrations.md. Never include credentials in client forms.
HUB_PROVIDER_CREDENTIALS=
HUB_SYNC_SECRET=
HUB_UPTIME_SECRET=
# Separate bounded HTML crawler. No PageSpeed key needed; enable after database/rate-limit setup.
SEO_AUDIT_ENABLED=false

# Public contact mail is independent of HUB_ENABLED. Enable only after the additive migration and sender checks.
CONTACT_EMAIL_ENABLED=false
CONTACT_EMAIL_FROM=Sitesnit <contact@sitesnit.nl>
# Resend webhook signing secret, server-only. Optional until configured; delivery stays unknown without it.
RESEND_CONTACT_WEBHOOK_SECRET=
