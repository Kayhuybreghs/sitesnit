PAGESPEED_API_KEY=
# Optional: Google Search Console verification value, never a Google API key.
GOOGLE_SITE_VERIFICATION=
# Keep false on preview. Production also requires the exact host sitesnit.nl.
SITESNIT_INDEXING_ENABLED=false
# Public GA4 measurement ID. No analytics is loaded without consent.
GA4_MEASUREMENT_ID=
# Enable only after Enhanced Measurement, Signals and user-provided data are disabled.
GA4_PRIVACY_CONFIGURED=false
# Neon PostgreSQL, provisioned through the Vercel Marketplace. Server-only.
DATABASE_URL=
# Set true ONLY in a local .env.local; omit on Vercel.
SITESNIT_LOCAL_SQLITE=false
# Independent random server secrets, at least 32 random bytes each.
RATE_LIMIT_SECRET=
CRON_SECRET=
